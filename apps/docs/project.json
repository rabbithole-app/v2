{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "command": "npm run dev -- --port 4300",
      "options": {
        "cwd": "apps/docs"
      }
    },
    "build": {
      "command": "npm run build",
      "options": {
        "cwd": "apps/docs"
      }
    },
    "preview": {
      "command": "npm run preview",
      "options": {
        "cwd": "apps/docs"
      }
    }
  }
}
