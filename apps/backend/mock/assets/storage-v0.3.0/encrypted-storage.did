type StorageAccessEvent = 
 variant {
   accessRequestCancelled: record {
                             requestId: nat;
                             requester: principal;
                           };
   accessRequestCreated: record {
                           requestId: nat;
                           requester: principal;
                         };
   accessRequestResolved:
    record {
      requestId: nat;
      requester: principal;
      status: AccessRequestStatus;
    };
   durablePolicyCancelled: record {policyId: nat;};
   durablePolicyCreated:
    record {
      policyId: nat;
      status: DurablePolicyStatus;
      trigger: DurablePolicyTrigger;
    };
   durablePolicyGraceStarted: record {policyId: nat;};
   durablePolicyMatured: record {policyId: nat;};
   durablePolicyReleased: record {policyId: nat;};
   ownerActivityRecorded:
    record {
      origin: OwnerActivityOrigin;
      "principal": principal;
      role: OwnerActivityRole;
    };
   pendingGrantCancelled: record {
                            grantId: nat;
                            ref: AccessRef;
                          };
   pendingGrantClaimed:
    record {
      accessClass: AccessClass;
      claimOrigin: opt EmailClaimOrigin;
      emailClaimState: opt EmailClaimState;
      grantId: nat;
      "principal": principal;
      source: AccessSource;
    };
   pendingGrantCreated:
    record {
      accessClass: AccessClass;
      grantId: nat;
      ref: AccessRef;
      source: AccessSource;
    };
   principalGrantCreated:
    record {
      accessClass: AccessClass;
      grantId: opt nat;
      "principal": principal;
      source: AccessSource;
    };
   principalGrantRevoked:
    record {
      accessClass: opt AccessClass;
      "principal": principal;
    };
   recoveryControllerCleared: record {"principal": principal;};
   recoveryControllerRegistered:
    record {
      previous: opt principal;
      "principal": principal;
    };
   recoveryOwnerAdded: record {"principal": principal;};
   recoveryOwnerRemoved: record {"principal": principal;};
 };
