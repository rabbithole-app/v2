# mops package cache (pulled on `mops install`)
.mops

# icp-cli ephemeral state
.icp/cache/
# Dynamic local/build canister-id mappings (ic.ids.json + staging.ids.json stay tracked).
.icp/data/mappings/local.ids.json
.icp/data/mappings/build.ids.json
.icp-state/
.icp-status/

# Derived init args — regenerated by scripts/generate-declarations.mjs
init-args/*.bin

# Local mock release candidates — committed baseline stays in mock/api/releases.json
# and mock/assets/storage-v*/ without the -dev suffix.
mock/api/releases.local.json
mock/assets/storage-v*-dev/
mock/assets/storage-v*-dev.*/

# Local dev secrets / machine-specific
.env
root.crt

# Misc
.DS_Store
