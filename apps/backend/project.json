{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "targets": {
    "compose": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "docker compose",
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      }
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "node scripts/bootstrap.mjs",
        "parallel": false
      }
    },
    "reset-local": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "node scripts/reset-local.mjs",
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      }
    },
    "sync-local-env": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "bash scripts/sync-env.sh local",
        "parallel": false
      }
    },
    "sync-staging-env": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "bash scripts/sync-env.sh staging",
        "parallel": false
      }
    },
    "sync-ic-env": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "bash scripts/sync-env.sh ic",
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "docker compose up -d --wait",
          "node scripts/bootstrap.mjs",
          "node scripts/generate-declarations.mjs",
          "icp deploy -e local --cycles 20t",
          "bash scripts/sync-env.sh local"
        ],
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      },
      "dependsOn": [{ "target": "build", "projects": ["rabbithole"] }]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "docker compose up -d --wait",
          "node scripts/bootstrap.mjs",
          "node scripts/generate-declarations.mjs",
          "icp deploy -e local --cycles 20t",
          "bash scripts/sync-env.sh local",
          "docker compose logs -f network caddy mock-server minio minio-init"
        ],
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "icp build",
        "parallel": false
      }
    },
    "generate-declarations": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "node scripts/generate-declarations.mjs",
        "parallel": false
      }
    },
    "install-ca": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/install-ca.sh",
        "cwd": "apps/backend"
      }
    },
    "generate-mock-assets": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx build storage --skip-nx-cache",
          "cd apps/backend && icp build -e build encrypted-storage",
          "node apps/backend/scripts/create-mock-storage-release.mjs --mode baseline --version 0.1.0 --max-commits 1 --id 1 --name \"Storage v0.1.0\" --created-at 2024-01-15T12:00:00Z"
        ],
        "parallel": false
      }
    },
    "generate-dev-storage-release": {
      "executor": "nx:run-commands",
      "options": {
      "commands": [
        "npx nx build storage --skip-nx-cache",
        "node apps/backend/scripts/create-mock-storage-release.mjs --mode dev"
      ],
        "parallel": false
      }
    },
    "clear-dev-storage-releases": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/backend/scripts/clear-dev-storage-releases.mjs",
        "parallel": false
      }
    },
    "sync-mock-storage-baseline": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/backend/scripts/sync-mock-storage-baseline.mjs",
        "parallel": false
      }
    },
    "act-release-storage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/backend/scripts/act-release-storage.mjs",
        "parallel": false
      }
    },
    "deploy-rabbithole": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "node scripts/generate-declarations.mjs",
          "icp deploy -e local rabbithole-backend --mode upgrade --args-file ./init-args/rabbithole-backend.local.bin --args-format hex --yes",
          "icp deploy -e local rabbithole-frontend --mode upgrade --yes",
          "bash scripts/sync-env.sh local"
        ],
        "parallel": false
      }
    }
  }
}
