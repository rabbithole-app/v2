{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "targets": {
    "compose": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "docker compose",
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      }
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "node scripts/bootstrap.mjs",
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "docker compose up -d --wait",
          "node scripts/bootstrap.mjs",
          "node scripts/generate-declarations.mjs",
          "icp deploy -e local --cycles 20t"
        ],
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      },
      "dependsOn": [
        { "target": "build", "projects": ["rabbithole"] }
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "docker compose up -d --wait",
          "node scripts/bootstrap.mjs",
          "node scripts/generate-declarations.mjs",
          "icp deploy -e local --cycles 20t",
          "docker compose logs -f network caddy mock-server"
        ],
        "env": { "COMPOSE_PROJECT_NAME": "rabbithole" },
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "icp build",
        "parallel": false
      }
    },
    "generate-declarations": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "node scripts/generate-declarations.mjs",
        "parallel": false
      }
    },
    "install-ca": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/install-ca.sh",
        "cwd": "apps/backend"
      }
    },
    "generate-mock-assets": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx build storage --skip-nx-cache",
          "cd apps/backend && icp build -e build encrypted-storage",
          "cp apps/backend/.icp/cache/artifacts/encrypted-storage apps/backend/mock/assets/encrypted-storage.wasm.gz",
          "COPYFILE_DISABLE=1 tar -cf apps/backend/mock/assets/storage-frontend.tar -C dist/apps/storage/browser .",
          "node apps/backend/mock/sync-release-metadata.mjs"
        ],
        "parallel": false
      }
    }
  }
}
