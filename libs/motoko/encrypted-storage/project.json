{
  "name": "encrypted-storage-mo",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/motoko/encrypted-storage",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko/encrypted-storage",
        "command": "icp build encrypted-storage",
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko/encrypted-storage",
        "command": "vitest",
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko",
        "command": "docker compose exec -T replica bash -lc 'cd /workspace/libs/encrypted-storage && npx lintoko'",
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko/encrypted-storage",
        "command": "icp deploy -e local encrypted-storage",
        "parallel": false
      }
    }
  }
}
