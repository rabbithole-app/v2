{
  "name": "treasury-mo",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/motoko/treasury",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko/treasury",
        "command": "icp build",
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko/treasury",
        "command": "vitest",
        "parallel": false
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/motoko/treasury",
        "command": "mops lint",
        "parallel": false
      }
    }
  }
}
