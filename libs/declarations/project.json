{
  "name": "declarations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/declarations/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project declarations --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd libs/declarations/src && swc . -d ../../../dist/libs/declarations/cjs --config-file ../.swcrc.cjs.json --ignore '**/*.d.ts'",
          "cd libs/declarations/src && swc . -d ../../../dist/libs/declarations/esm --config-file ../.swcrc.esm.json --ignore '**/*.d.ts'",
          "tsc -p libs/declarations/tsconfig.build.json",
          "rsync -am --include='*/' --include='*.d.ts' --exclude='*' libs/declarations/src/ dist/libs/declarations/cjs/",
          "rsync -am --include='*/' --include='*.d.ts' --exclude='*' libs/declarations/src/ dist/libs/declarations/esm/",
          "cp dist/libs/declarations/types/index.d.ts dist/libs/declarations/cjs/",
          "cp dist/libs/declarations/types/index.d.ts dist/libs/declarations/esm/"
        ],
        "parallel": false
      }
    }
  }
}
